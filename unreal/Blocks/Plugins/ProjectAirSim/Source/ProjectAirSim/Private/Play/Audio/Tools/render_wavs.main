// Standalone renderer for the play-mode sounds; needs no Unreal. The .main extension keeps the Unreal
// build from compiling it.
//   clang++ -std=c++17 -O2 -x c++ -I.. render_wavs.main -o render_wavs && ./render_wavs <seconds> <path prefix>
// Writes <prefix>_menu.wav, _flight.wav, _click.wav, _confirm.wav, _rotor_low.wav, _rotor_high.wav and
// fails if any sample would clip or is not finite.

#include <cmath>
#include <cstdio>
#include <cstdlib>

#include "PlayAudioDsp.h"

int main(int argc, char** argv) {
  if (argc != 3) {
    std::fprintf(stderr, "usage: %s <seconds> <path prefix>\n", argv[0]);
    return 2;
  }
  const float seconds = static_cast<float>(std::atof(argv[1]));
  const std::string prefix = argv[2];
  constexpr int kRate = 48000;
  using PlayAudioDsp::Sound;
  int status = 0;
  for (Sound s : {Sound::Menu, Sound::Flight, Sound::Click, Sound::Confirm, Sound::RotorLow,
                  Sound::RotorHigh}) {
    const std::vector<float> pcm = PlayAudioDsp::RenderSound(s, seconds, kRate);
    float peak = 0.f;
    double sq = 0.0;
    bool finite = true;
    for (float v : pcm) {
      finite = finite && std::isfinite(v);
      peak = std::max(peak, std::fabs(v));
      sq += static_cast<double>(v) * v;
    }
    const double rms = std::sqrt(sq / static_cast<double>(pcm.size()));
    const std::string path = prefix + PlayAudioDsp::SoundSuffix(s);
    PlayAudioDsp::WriteWav(path, pcm, kRate);
    std::printf("%-40s peak %.3f rms %.4f (%.1f dBFS)\n", path.c_str(), peak, rms,
                20.0 * std::log10(rms + 1e-12));
    if (!finite || peak >= 0.98f) {
      std::fprintf(stderr, "FAIL: %s %s\n", path.c_str(), finite ? "clips" : "has non-finite samples");
      status = 1;
    }
  }
  return status;
}
